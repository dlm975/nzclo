[
  {
    "name": "theme_info",
    "theme_name": "nzclo",
    "theme_version": "1.0.0",
    "theme_author": "nzclo",
    "theme_documentation_url": "https://nzclo.com",
    "theme_support_url": "https://nzclo.com"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image (optional — wordmark used if empty)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 110
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary text",
        "default": "#67645e"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_tile",
        "label": "Product tile background",
        "default": "#f1f0ed"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Fonts are off by default so the theme keeps its current system typeface. Turn one on to pick a Shopify font for that role; individual sections can still override it."
      },
      {
        "type": "checkbox",
        "id": "type_body_font_enable",
        "label": "Use a custom body font",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "checkbox",
        "id": "type_heading_font_enable",
        "label": "Use a custom heading font",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "checkbox",
        "id": "type_button_font_enable",
        "label": "Use a custom button font",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "type_button_font",
        "label": "Button font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Open cart drawer when adding to cart",
        "default": true
      },
      {
        "type": "header",
        "content": "Social proof"
      },
      {
        "type": "paragraph",
        "content": "Shown just above the checkout button. Stars are decorative and make no third-party rating claim. To show a real review score, upload the official badge supplied by your reviews provider."
      },
      {
        "type": "checkbox",
        "id": "cart_social_enable",
        "label": "Show social proof strip",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_social_text",
        "label": "Text",
        "default": "100+ HAPPY CUSTOMERS"
      },
      {
        "type": "image_picker",
        "id": "cart_social_image",
        "label": "Badge image (replaces the stars)"
      },
      {
        "type": "range",
        "id": "cart_social_image_height",
        "min": 12,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Badge height",
        "default": 20
      },
      {
        "type": "header",
        "content": "Reward progress"
      },
      {
        "type": "paragraph",
        "content": "The bar reflects cart quantity only. The theme cannot create discounts: to make these rewards real, create two Automatic discounts in Shopify admin (Discounts > Create > Automatic) — 5% off with a minimum quantity of 2, and Free shipping with a minimum quantity of 3. Keep the quantities below matching those discounts."
      },
      {
        "type": "checkbox",
        "id": "cart_reward_enable",
        "label": "Show reward progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "cart_reward_tier1_qty",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "Reward 1 — items required",
        "default": 2
      },
      {
        "type": "text",
        "id": "cart_reward_tier1_label",
        "label": "Reward 1 — label",
        "default": "5% OFF"
      },
      {
        "type": "range",
        "id": "cart_reward_tier2_qty",
        "min": 2,
        "max": 20,
        "step": 1,
        "label": "Reward 2 — items required",
        "default": 3
      },
      {
        "type": "text",
        "id": "cart_reward_tier2_label",
        "label": "Reward 2 — label",
        "default": "FREE SHIPPING"
      },
      {
        "type": "paragraph",
        "content": "In the messages below, [n] is replaced with the number of items still needed."
      },
      {
        "type": "text",
        "id": "cart_reward_msg_start",
        "label": "Message — empty cart",
        "default": "Add [n] items to unlock 5% off!"
      },
      {
        "type": "text",
        "id": "cart_reward_msg_progress",
        "label": "Message — before reward 1",
        "default": "Add [n] more item to unlock 5% off!"
      },
      {
        "type": "text",
        "id": "cart_reward_msg_tier1",
        "label": "Message — reward 1 reached",
        "default": "5% OFF unlocked! Add [n] more item for free shipping."
      },
      {
        "type": "text",
        "id": "cart_reward_msg_complete",
        "label": "Message — reward 2 reached",
        "default": "Free shipping unlocked!"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Pre-order",
    "settings": [
      {
        "type": "paragraph",
        "content": "Products with no stock are offered as pre-order: they show a pre-order badge and their buy button becomes a request link to the special order page."
      },
      {
        "type": "text",
        "id": "sale_label",
        "label": "Sale badge label",
        "default": "sale"
      },
      {
        "type": "text",
        "id": "preorder_label",
        "label": "Badge label",
        "default": "Pre-Order"
      },
      {
        "type": "text",
        "id": "preorder_cta_label",
        "label": "Request button label",
        "default": "Create an order request"
      },
      {
        "type": "textarea",
        "id": "preorder_message",
        "label": "Product page message",
        "default": "This item is currently out of stock. Send us a request and we'll come back to you with pricing and availability."
      },
      {
        "type": "text",
        "id": "preorder_page_url",
        "label": "Special order page path",
        "default": "/pages/special-order"
      },
      {
        "type": "color",
        "id": "preorder_color",
        "label": "Pre-order colour",
        "default": "#2563eb"
      },
      {
        "type": "color",
        "id": "preorder_text_color",
        "label": "Pre-order text colour",
        "default": "#ffffff"
      }
    ]
  }
]
