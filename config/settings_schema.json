[
  {
    "name": "theme_info",
    "theme_name": "nzclo",
    "theme_version": "1.0.0",
    "theme_author": "nzclo",
    "theme_documentation_url": "https://nzclo.com",
    "theme_support_url": "https://nzclo.com"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image (optional — wordmark used if empty)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 110
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary text",
        "default": "#67645e"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_tile",
        "label": "Product tile background",
        "default": "#f1f0ed"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Open cart drawer when adding to cart",
        "default": true
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Pre-order",
    "settings": [
      {
        "type": "paragraph",
        "content": "Products with no stock are offered as pre-order: they show a pre-order badge and their buy button becomes a request link to the special order page."
      },
      {
        "type": "text",
        "id": "preorder_label",
        "label": "Badge label",
        "default": "Pre-Order"
      },
      {
        "type": "text",
        "id": "preorder_cta_label",
        "label": "Request button label",
        "default": "Create an order request"
      },
      {
        "type": "textarea",
        "id": "preorder_message",
        "label": "Product page message",
        "default": "This item is currently out of stock. Send us a request and we'll come back to you with pricing and availability."
      },
      {
        "type": "text",
        "id": "preorder_page_url",
        "label": "Special order page path",
        "default": "/pages/special-order"
      },
      {
        "type": "color",
        "id": "preorder_color",
        "label": "Pre-order colour",
        "default": "#2563eb"
      },
      {
        "type": "color",
        "id": "preorder_text_color",
        "label": "Pre-order text colour",
        "default": "#ffffff"
      }
    ]
  }
]
