{%- comment -%} Usage: {% render 'price', product: product %} or variant: variant {%- endcomment -%}
{%- if variant -%}
  {%- if variant.compare_at_price > variant.price -%}
    <s>{{ variant.compare_at_price | money }}</s>{{ variant.price | money }}
  {%- else -%}
    {{ variant.price | money }}
  {%- endif -%}
{%- elsif product -%}
  {%- if product.compare_at_price > product.price -%}
    <s>{{ product.compare_at_price | money }}</s>{{ product.price | money }}
  {%- elsif product.price_varies -%}
    from {{ product.price_min | money }}
  {%- else -%}
    {{ product.price | money }}
  {%- endif -%}
{%- endif -%}
