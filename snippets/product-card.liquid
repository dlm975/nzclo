{%- comment -%}
  Renders a 9:16 product card: an undistorted 3:4 photograph at the top, extended
  to the full card height by a blurred, scaled continuation of the same image, with
  the product information set over that blur.

  Usage: {% render 'product-card', product: product %}
  Optional: block_attributes - pass block.shopify_attributes when rendered from a section block
{%- endcomment -%}

{%- liquid
  assign primary = product.featured_media
  assign secondary = null
  if product.media.size > 1
    assign secondary = product.media[1]
  endif

  assign color_option = null
  for product_option in product.options_with_values
    assign option_name = product_option.name | downcase
    if option_name contains 'color' or option_name contains 'colour'
      assign color_option = product_option
      break
    endif
  endfor

  assign swatch_total = color_option.values.size

  comment
    Build the set of colour values that still have an in-stock variant, so the
    swatches can lead with what is actually buyable. Live inventory only.
  endcomment
  assign color_position = color_option.position
  assign available_values = '||'
  for variant in product.variants
    if variant.available
      if color_position == 1
        assign variant_value = variant.option1
      elsif color_position == 2
        assign variant_value = variant.option2
      else
        assign variant_value = variant.option3
      endif
      assign available_values = available_values | append: variant_value | append: '||'
    endif
  endfor

  comment
    Quick add is only safe when a variant is fully determined: a single-variant
    product, or one whose only option is the colour the swatches already set.
    Anything with an unresolved option (size, etc.) goes to the product page.
  endcomment
  comment
    Pre-order request link, built exactly as the original module did:
    /pages/special-order?product=<title>&link=<absolute product url>
  endcomment
  assign po_product = product.title | url_encode
  capture po_link_raw
    echo shop.url
    echo product.url
  endcapture
  assign po_link = po_link_raw | url_encode
  assign po_base = settings.preorder_page_url | default: '/pages/special-order'
  capture preorder_href
    echo po_base
    echo '?product='
    echo po_product
    echo '&link='
    echo po_link
  endcapture

  assign default_variant = product.selected_or_first_available_variant
  assign can_quick_add = false
  if product.available
    if product.variants.size == 1
      assign can_quick_add = true
    elsif product.options.size == 1 and color_option
      assign can_quick_add = true
    endif
  endif
-%}

<div class="product-card{% if secondary %} product-card--swap{% endif %}{% unless product.available %} product-card--preorder{% endunless %}"{% if block_attributes %} {{ block_attributes }}{% endif %}>
  <div class="product-card__media">
    {%- if primary -%}
      <span class="product-card__bleed" aria-hidden="true">
        <img
          class="pc-img--primary"
          src="{{ primary | image_url: width: 400 }}"
          alt=""
          loading="lazy"
          width="400"
          height="533"
        >
        {%- if secondary -%}
          <img
            class="pc-img--secondary"
            src="{{ secondary | image_url: width: 400 }}"
            alt=""
            loading="lazy"
            width="400"
            height="533"
          >
        {%- endif -%}
      </span>

      <span class="product-card__shot">
        <img
          class="pc-img--primary"
          src="{{ primary | image_url: width: 700 }}"
          srcset="{{ primary | image_url: width: 400 }} 400w, {{ primary | image_url: width: 700 }} 700w, {{ primary | image_url: width: 1000 }} 1000w"
          sizes="(max-width: 749px) 50vw, (max-width: 1099px) 33vw, 25vw"
          alt="{{ primary.alt | default: product.title | escape }}"
          loading="lazy"
          width="600"
          height="800"
        >
        {%- if secondary -%}
          <img
            class="pc-img--secondary"
            src="{{ secondary | image_url: width: 700 }}"
            srcset="{{ secondary | image_url: width: 400 }} 400w, {{ secondary | image_url: width: 700 }} 700w, {{ secondary | image_url: width: 1000 }} 1000w"
            sizes="(max-width: 749px) 50vw, (max-width: 1099px) 33vw, 25vw"
            alt=""
            loading="lazy"
            width="600"
            height="800"
          >
        {%- endif -%}
      </span>
    {%- else -%}
      <span class="product-card__shot">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
    {%- endif -%}

    <a class="product-card__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}"></a>

    <span class="product-card__scrim"></span>

    {%- if can_quick_add -%}
      <button
        type="button"
        class="product-card__add"
        data-card-add
        data-variant-id="{{ default_variant.id }}"
        aria-label="{{ 'products.product.add_to_cart' | t }} — {{ product.title | escape }}"
      >
        <svg class="product-card__add-icon product-card__add-icon--plus" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13"/></svg>
        <svg class="product-card__add-icon product-card__add-icon--check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      </button>
    {%- elsif product.available -%}
      <a
        class="product-card__add product-card__add--options"
        href="{{ product.url }}"
        aria-label="{{ 'products.product.choose_options' | t }} — {{ product.title | escape }}"
      >
        <svg class="product-card__add-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13"/></svg>
      </a>
    {%- endif -%}

    {%- comment -%} shown instead of the above whenever the card is in its pre-order state {%- endcomment -%}
    <a
      class="product-card__add product-card__add--preorder"
      href="{{ preorder_href }}"
      data-preorder-link
      aria-label="{{ settings.preorder_cta_label | default: 'Create an order request' }} — {{ product.title | escape }}"
    >
      <svg class="product-card__add-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13"/></svg>
    </a>

    {%- if product.compare_at_price > product.price and product.available -%}
      <span class="product-card__badge">{{ settings.sale_label | default: 'sale' }}</span>
    {%- endif -%}
    <span class="product-card__badge product-card__badge--preorder">{{ settings.preorder_label | default: 'Pre-Order' }}</span>

    <span class="product-card__info">
      {%- comment -%} product type is deliberately not shown here {%- endcomment -%}
      {%- if product.metafields.custom.subtitle != blank -%}
        <span class="product-card__eyebrow">{{ product.metafields.custom.subtitle }}</span>
      {%- endif -%}

      <h3 class="product-card__title">{{ product.title }}</h3>

      <span class="product-card__row">
        <span class="product-card__price">{% render 'price', product: product %}</span>

        {%- if color_option -%}
          <span class="product-card__swatches">
            {%- assign swatch_shown = 0 -%}

            {%- for value in color_option.values -%}
              {%- assign needle = '||' | append: value | append: '||' -%}
              {%- if available_values contains needle -%}
                {% render 'product-swatch', value: value, is_available: true, product: product, color_position: color_position %}
                {%- assign swatch_shown = swatch_shown | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}

            {%- for value in color_option.values -%}
              {%- assign needle = '||' | append: value | append: '||' -%}
              {%- unless available_values contains needle -%}
                {% render 'product-swatch', value: value, is_available: false, product: product, color_position: color_position %}
                {%- assign swatch_shown = swatch_shown | plus: 1 -%}
              {%- endunless -%}
            {%- endfor -%}

            {%- comment -%}
              Every colour is rendered. Desktop shows them all; CSS hides the fifth
              onward on mobile, so only a mobile remainder count is needed.
            {%- endcomment -%}
            {%- assign mobile_shown = swatch_total -%}
            {%- if mobile_shown > 4 -%}
              {%- assign mobile_shown = 4 -%}
            {%- endif -%}
            {%- assign overflow_narrow = swatch_total | minus: mobile_shown -%}

            {%- if overflow_narrow > 0 -%}
              <span class="product-card__swatch-more product-card__swatch-more--narrow">+{{ overflow_narrow }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </span>
    </span>
  </div>
</div>
