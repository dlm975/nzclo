{%- comment -%} Usage inside paginate tags: {% render 'pagination', paginate: paginate %} {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" aria-label="previous page">&larr;</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" aria-label="next page">&rarr;</a>
    {%- endif -%}
  </nav>
{%- endif -%}
