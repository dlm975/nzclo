{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.subtext' | t }} — {{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% style %}
      :root {
        --color-text: 0, 0, 0;
        --color-text-secondary: 103, 100, 94;
        --color-background: 255, 255, 255;
        --color-tile: 241, 240, 237;
        --color-button: 0, 0, 0;
        --color-button-text: 255, 255, 255;
      }
    {% endstyle %}
  </head>
  <body>
    <main class="page-width account-wrap" style="text-align: center;">
      {%- assign formatted_value = gift_card.initial_value | money_without_trailing_zeros -%}
      <h1 class="h-section">{{ 'gift_cards.issued.title' | t: value: formatted_value, shop: shop.name }}</h1>
      {%- if gift_card.expired -%}
        <p class="text-secondary">{{ 'gift_cards.issued.expired' | t }}</p>
      {%- endif -%}
      <div class="address-card" style="display: inline-block; padding: 32px 48px; margin: 24px 0;">
        <p class="text-small text-secondary" style="margin: 0 0 8px;">{{ 'gift_cards.issued.gift_card_code' | t }}</p>
        <p style="font-size: 22px; letter-spacing: 0.12em; margin: 0;">{{ gift_card.code | format_code }}</p>
        <p style="margin: 12px 0 0;">{{ gift_card.balance | money }}</p>
      </div>
      <div style="display: flex; gap: 10px; justify-content: center;">
        <a class="btn btn--solid" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button class="btn btn--outline" onclick="window.print();">{{ 'gift_cards.issued.print_gift_card' | t }}</button>
      </div>
    </main>
  </body>
</html>
