<div class="page-width account-wrap" style="max-width: 640px;">
  <h1 class="h-section text-center">{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}
    <p class="text-secondary text-center" style="margin-top: -12px; margin-bottom: 28px;">{{ section.settings.text }}</p>
  {%- endif -%}

  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-success">thanks for reaching out — we'll get back to you soon.</p>
    {%- endif -%}
    {%- if form.errors -%}
      <p class="form-errors">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
      <div>
        <label class="field-label" for="ContactName">name</label>
        <input class="field" type="text" name="contact[name]" id="ContactName" autocomplete="name">
      </div>
      <div>
        <label class="field-label" for="ContactEmail">email</label>
        <input class="field" type="email" name="contact[email]" id="ContactEmail" autocomplete="email" required>
      </div>
    </div>
    <div class="form-row">
      <label class="field-label" for="ContactBody">message</label>
      <textarea class="field" name="contact[body]" id="ContactBody" rows="6" required></textarea>
    </div>
    <button class="btn btn--solid btn--full" type="submit">send</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "contact us" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "questions about sizing, shipping, or an order? send us a message." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
