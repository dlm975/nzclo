{%- liquid
  assign po_product = product.title | url_encode
  capture po_link_raw
    echo shop.url
    echo product.url
  endcapture
  assign po_link = po_link_raw | url_encode
  comment
    Desktop lays three shots out beside the information column, so it needs to
    know which media belong to which colour.

    The variant's own featured_media is the authority: it is Shopify's real
    variant-to-media relationship, and it is what IMG 1 becomes. Position is
    only ever used afterwards, to pick up the shots uploaded alongside it, and
    it can never override a media item another colour's variant points at.
  endcomment
  assign color_option = null
  for product_option in product.options_with_values
    assign option_name = product_option.name | downcase
    if option_name contains 'color' or option_name contains 'colour'
      assign color_option = product_option
      break
    endif
  endfor

  assign media_groups = ''
  if color_option and product.media.size > 0
    assign color_position = color_option.position

    comment
      Every media item any variant points at, so a positional range can be
      stopped from claiming a shot that demonstrably belongs to another colour.
    endcomment
    capture variant_media_all
      for variant in product.variants
        if variant.featured_media
          echo '|'
          echo variant.featured_media.id
        endif
      endfor
      echo '|'
    endcapture

    comment
      Per colour, in colour order: the media its own variants point at, the
      first of those (IMG 1), and that one's position (the range anchor).
    endcomment
    capture colour_media_csv
      for value in color_option.values
        for variant in product.variants
          if color_position == 1
            assign variant_value = variant.option1
          elsif color_position == 2
            assign variant_value = variant.option2
          else
            assign variant_value = variant.option3
          endif
          comment
            option.values yields value drops, variant.optionN yields strings, so
            both sides are forced to a string before they are compared
          endcomment
          assign value_name = value | append: ''
          if variant_value == value_name and variant.featured_media
            echo '|'
            echo variant.featured_media.id
          endif
        endfor
        echo '|'
        unless forloop.last
          echo '~'
        endunless
      endfor
    endcapture
    assign colour_media = colour_media_csv | split: '~'

    capture primary_csv
      for value in color_option.values
        assign primary_id = 0
        assign primary_pos = 0
        for variant in product.variants
          if color_position == 1
            assign variant_value = variant.option1
          elsif color_position == 2
            assign variant_value = variant.option2
          else
            assign variant_value = variant.option3
          endif
          comment
            option.values yields value drops, variant.optionN yields strings, so
            both sides are forced to a string before they are compared
          endcomment
          assign value_name = value | append: ''
          if variant_value == value_name and variant.featured_media
            assign primary_id = variant.featured_media.id
            assign primary_pos = variant.featured_media.position
            break
          endif
        endfor
        echo primary_id
        echo ':'
        echo primary_pos
        unless forloop.last
          echo ','
        endunless
      endfor
    endcapture
    assign primaries = primary_csv | split: ','

    capture media_groups
      echo '{'
      for value in color_option.values
        assign pair = primaries[forloop.index0] | strip | split: ':'
        assign primary_id = pair[0] | times: 1
        assign anchor = pair[1] | times: 1
        assign mine = colour_media[forloop.index0]

        comment
          The range runs from this colour's anchor to the next colour's. Shots
          ahead of the very first anchor are deliberately left out: they belong
          to no variant, and folding them in is what used to put a generic
          product shot into IMG 1.
        endcomment
        assign stop = 99999
        for other in primaries
          assign other_pos = other | strip | split: ':' | last | times: 1
          if other_pos > anchor and other_pos < stop
            assign stop = other_pos
          endif
        endfor

        unless forloop.first
          echo ','
        endunless
        assign group_key = value | append: '' | downcase | strip
        echo group_key | json
        echo ':{"primary":'
        echo primary_id
        echo ',"media":['

        assign written = 0
        if primary_id > 0
          echo primary_id
          assign written = 1
        endif
        for media in product.media
          assign needle = '|' | append: media.id | append: '|'
          assign include = false
          if media.id == primary_id
            assign include = false
          elsif mine contains needle
            comment
              another of this colour's variants points at it, wherever it sits
            endcomment
            assign include = true
          elsif anchor > 0 and media.position > anchor and media.position < stop
            unless variant_media_all contains needle
              assign include = true
            endunless
          endif
          if include
            if written > 0
              echo ','
            endif
            echo media.id
            assign written = written | plus: 1
          endif
        endfor
        echo ']}'
      endfor
      echo '}'
    endcapture
  endif

  assign po_base = settings.preorder_page_url | default: '/pages/special-order'
  capture preorder_href
    echo po_base
    echo '?product='
    echo po_product
    echo '&link='
    echo po_link
  endcapture
-%}

<div class="page-width">
  <div class="product-page" data-product-form-wrapper data-update-url data-money-format="{{ shop.money_format | escape }}">
    <script type="application/json" data-product-json>{{ product | json }}</script>

    {%- if media_groups != blank -%}
      <script type="application/json" data-media-groups>{{ media_groups }}</script>
    {%- endif -%}

    {%- liquid
      assign slot_count = product.media.size
      if slot_count > 3
        assign slot_count = 3
      endif
      if slot_count < 1
        assign slot_count = 1
      endif
    -%}
    <div class="product-gallery" data-gallery-grid data-slots="{{ slot_count }}">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          <div
            class="product-gallery__item{% if forloop.first %} is-active{% endif %}"
            data-gallery-item
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            {%- comment -%} the first three fill the desktop grid; mobile ignores the slot {%- endcomment -%}
            {% if forloop.index0 < 3 %}data-slot="{{ forloop.index0 }}"{% endif %}
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1100 }}"
                  srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1600 }} 1600w"
                  sizes="(max-width: 899px) 86vw, 55vw"
                  alt="{{ media.alt | escape }}"
                  {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  width="1100"
                  height="{{ 1100 | divided_by: media.aspect_ratio | round }}"
                >
              {%- when 'video', 'external_video' -%}
                {{ media | media_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="product-gallery__item is-active" data-slot="0">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- if product.media.size > 1 -%}
        {%- comment -%}
          With three shots or fewer the desktop grid holds them all, so the
          carousel has nothing left to show there. Mobile still shows it.
        {%- endcomment -%}
        <div class="product-thumbs-wrap"{% if product.media.size <= 3 %} data-thumbs-empty{% endif %}>
          <button type="button" class="product-thumbs__arrow product-thumbs__arrow--prev" data-thumbs-prev aria-label="Previous images">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <div class="product-thumbs" data-thumbs-track>
          {%- for media in product.media -%}
            <button
              type="button"
              class="product-thumb{% if forloop.first %} is-active{% endif %}"
              data-gallery-thumb
              data-media-id="{{ media.id }}"
              {%- comment -%} already on the desktop grid, so kept out of the desktop carousel {%- endcomment -%}
              {% if forloop.index0 < 3 %}data-thumb-hidden{% endif %}
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ product.title | escape }} — {{ forloop.index }}"
            >
              <img src="{{ media | image_url: width: 220 }}" alt="" loading="lazy" width="110" height="138">
            </button>
          {%- endfor -%}
          </div>
          <button type="button" class="product-thumbs__arrow product-thumbs__arrow--next" data-thumbs-next aria-label="More images">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title | downcase }}</h1>
      <div class="product-info__price">
        <span data-price>{% render 'price', variant: product.selected_or_first_available_variant %}</span>
        <span class="preorder-badge">{{ settings.preorder_label | default: 'Pre-Order' }}</span>
      </div>

      {%- form 'product', product, data-ajax-add: '' -%}
        {%- liquid
          comment
            Nothing is selected on arrival: the customer picks the options
            themselves. A ?variant= link is an explicit choice, so that one is
            honoured, and a product with no options has nothing to choose.
          endcomment
          assign current_variant = product.selected_variant
          assign needs_options = false
          if product.has_only_default_variant
            assign current_variant = product.variants.first
          elsif current_variant == nil
            assign needs_options = true
          endif
        -%}

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="option-group" data-option-group style="border: none; padding: 0; margin: 0 0 20px;">
              <legend class="option-group__label">{{ option.name | downcase }}</legend>
              <div class="option-pills">
                {%- for value in option.values -%}
                  <span class="option-pill">
                    <input
                      type="radio"
                      id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}"
                      name="option-{{ option.position }}"
                      value="{{ value | escape }}"
                      {% if current_variant and option.selected_value == value %}checked{% endif %}
                    >
                    <label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value | downcase }}</label>
                  </span>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="option-group">
          <p class="option-group__label">{{ 'products.product.quantity' | t }}</p>
          <div class="qty-input">
            <button type="button" data-qty-change="-1" aria-label="decrease quantity">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-change="1" aria-label="increase quantity">+</button>
          </div>
        </div>

        {%- comment -%} empty until the customer has chosen, so no variant is assumed {%- endcomment -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- if settings.preorder_message != blank -%}
          <p class="preorder-note">{{ settings.preorder_message }}</p>
        {%- endif -%}

        <div class="product-form__buttons" data-buy-observe>
          <button
            type="submit"
            class="btn btn--solid btn--full"
            data-add-to-cart
            data-label-add="{{ 'products.product.add_to_cart' | t }}"
            data-label-choose="{{ 'products.product.choose_options' | t }}"
            {%- comment -%}
              data-needs-options is what separates "has not chosen yet" from
              "chose something that cannot be bought": both disable the button,
              but only the second one brings out the pre-order CTA.
            {%- endcomment -%}
            {% if needs_options %}data-needs-options{% endif %}
            {% if needs_options or current_variant.available == false %}disabled{% endif %}
          >
            <span data-add-to-cart-text>
              {%- if needs_options -%}
                {{ 'products.product.choose_options' | t }}
              {%- elsif current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
          {{ form | payment_button }}

          {%- comment -%} replaces the buy buttons whenever the chosen variant is unavailable {%- endcomment -%}
          <a class="preorder-cta" href="{{ preorder_href }}">
            <span aria-hidden="true">+</span>
            {{ settings.preorder_cta_label | default: 'Create an order request' }}
          </a>
        </div>
      {%- endform -%}

      <div class="product-accordions">
        {%- if product.description != blank -%}
          <details>
            <summary>{{ 'products.product.description' | t }}</summary>
            <div class="accordion__content rte">{{ product.description }}</div>
          </details>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' and block.settings.content != blank -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title | downcase }}</summary>
              <div class="accordion__content">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  Shown once the buy controls leave the viewport. Pointer events are off in the
  stylesheet so the bar never takes a click meant for the page underneath it;
  the + button turns them back on for itself. It opens the cart drawer's own
  mini PDP rather than carrying a second buy button.
{%- endcomment -%}
<div class="pdp-bar" data-pdp-bar>
  <span class="pdp-bar__media">
    {%- if product.featured_media -%}
      <img
        data-pdp-bar-image
        src="{{ product.featured_media | image_url: width: 160 }}"
        alt=""
        loading="lazy"
        width="80"
        height="107"
      >
    {%- endif -%}
  </span>
  <span class="pdp-bar__title">{{ product.title | downcase }}</span>
  <span class="pdp-bar__price" data-pdp-bar-price>
    {%- render 'price', variant: product.selected_or_first_available_variant -%}
  </span>
  <button
    type="button"
    class="pdp-bar__add"
    data-pdp-bar-add
    aria-label="{{ 'products.product.choose_options' | t }} — {{ product.title | escape }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5v13M5.5 12h13"/></svg>
  </button>
</div>

<div style="height: clamp(40px, 6vw, 88px);"></div>

{% schema %}
{
  "name": "Product page",
  "settings": [],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "details" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ]
}
{% endschema %}
