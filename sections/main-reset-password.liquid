<div class="page-width account-wrap">
  <h1 class="h-section">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <p class="form-errors">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="form-row">
      <label class="field-label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input class="field" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    </div>
    <div class="form-row">
      <label class="field-label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input class="field" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    </div>
    <button class="btn btn--solid btn--full" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
