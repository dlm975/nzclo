<div class="page-width section-pad">
  <p><a class="link-underline" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a></p>
  <h1 class="h-section">{{ 'customer.order.title' | t: name: order.name }}</h1>
  {%- assign order_date = order.created_at | date: '%d %b %Y' -%}
  <p class="text-secondary text-small">{{ 'customer.order.date_html' | t: date: order_date }}</p>

  <table class="account-table" style="margin-top: 24px;">
    <thead>
      <tr>
        <th>{{ 'customer.order.product' | t }}</th>
        <th>{{ 'customer.order.price' | t }}</th>
        <th>{{ 'customer.order.quantity' | t }}</th>
        <th>{{ 'customer.order.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            {{ line_item.title | downcase }}
            {%- if line_item.sku != blank -%}<br><span class="text-small text-secondary">{{ line_item.sku }}</span>{%- endif -%}
          </td>
          <td>{{ line_item.final_price | money }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3">{{ 'customer.order.subtotal' | t }}</td>
        <td>{{ order.line_items_subtotal_price | money }}</td>
      </tr>
      {%- for shipping_method in order.shipping_methods -%}
        <tr>
          <td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
          <td>{{ shipping_method.price | money }}</td>
        </tr>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <tr>
          <td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
          <td>{{ tax_line.price | money }}</td>
        </tr>
      {%- endfor -%}
      <tr>
        <td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td>
        <td><strong>{{ order.total_net_amount | money }}</strong></td>
      </tr>
    </tfoot>
  </table>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 32px; max-width: 640px;">
    <div>
      <h2 class="h-card">{{ 'customer.order.billing_address' | t }}</h2>
      {{ order.billing_address | format_address }}
    </div>
    <div>
      <h2 class="h-card">{{ 'customer.order.shipping_address' | t }}</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}
