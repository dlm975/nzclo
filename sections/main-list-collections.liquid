<div class="page-width section-pad">
  <h1 class="h-section">collections</h1>
  <div class="collection-tiles" style="--tiles: 3;">
    {%- for collection in collections -%}
      <a class="collection-tile" href="{{ collection.url }}">
        {%- if collection.featured_image -%}
          <img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="900" height="1200">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <span class="collection-tile__label">{{ collection.title | downcase }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
