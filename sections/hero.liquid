<div
  class="hero{% if section.settings.height == 'short' %} hero--short{% endif %} hero--{{ section.settings.text_position }}"
  style="--hero-overlay: {{ section.settings.overlay_opacity | default: 20 | divided_by: 100.0 }};"
>
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2200 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1500 }} 1500w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="2200"
        height="{{ 2200 | divided_by: section.settings.image.aspect_ratio | round }}"
        {% if section.index == 1 %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
      >
    {%- endif -%}
  </div>
  <div class="hero__content{% if section.settings.dark_text %} hero__content--dark{% endif %}">
    {%- if section.settings.heading != blank -%}
      {%- if section.settings.heading_style == 'display' -%}
        <h2 class="h-hero"{% render 'text-attrs', s: section.settings, p: 'heading' %}>{{ section.settings.heading }}</h2>
      {%- else -%}
        <p class="hero__tagline"{% render 'text-attrs', s: section.settings, p: 'heading' %}>{{ section.settings.heading }}</p>
      {%- endif -%}
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn {% if section.settings.dark_text %}btn--outline{% else %}btn--glass{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"{% render 'text-attrs', s: section.settings, p: 'button' %}>{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

