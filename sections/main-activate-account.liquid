<div class="page-width account-wrap">
  <h1 class="h-section">{{ 'customer.activate_account.title' | t }}</h1>
  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}
      <p class="form-errors">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="form-row">
      <label class="field-label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
      <input class="field" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
    </div>
    <div class="form-row">
      <label class="field-label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input class="field" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
    </div>
    <div style="display: grid; gap: 10px;">
      <button class="btn btn--solid btn--full" type="submit">{{ 'customer.activate_account.submit' | t }}</button>
      <button class="btn btn--outline btn--full" type="submit" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Activate account",
  "settings": []
}
{% endschema %}
