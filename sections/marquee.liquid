{%- if section.settings.text != blank -%}
  <div class="marquee" style="--marquee-speed: {{ section.settings.speed }}s;" aria-hidden="true">
    {%- for i in (1..2) -%}
      <div class="marquee__track">
        {%- for j in (1..6) -%}
          <span class="marquee__item"{% render 'text-attrs', s: section.settings, p: 'text' %}>{{ section.settings.text }}</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "authentic product. no compromise. shipped from nz."
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Loop duration",
      "default": 24
    },
    {
      "type": "header",
      "content": "Text type"
    },
    {
      "type": "checkbox",
      "id": "text_font_enable",
      "label": "Use a custom font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 0,
      "max": 96,
      "step": 1,
      "unit": "px",
      "label": "Size — desktop (0 keeps theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Size — mobile (0 keeps theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Weight",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extrabold"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": -10,
      "max": 40,
      "step": 1,
      "label": "Letter spacing — /100 em (0 keeps theme default)",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_line_height",
      "min": 0,
      "max": 30,
      "step": 1,
      "label": "Line height — /10 (0 keeps theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Capitalisation",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalise"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Colour"
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}
