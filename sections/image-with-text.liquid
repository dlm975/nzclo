<div class="page-width section-pad" style="padding-top: 0;">
  <div class="iwt"{% if section.settings.reverse %} style="direction: rtl;"{% endif %}>
    <div class="iwt__media"{% if section.settings.reverse %} style="direction: ltr;"{% endif %}>
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 899px) 100vw, 50vw"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="1200"
          height="1500"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="iwt__content"{% if section.settings.reverse %} style="direction: ltr;"{% endif %}>
      {%- if section.settings.heading != blank -%}
        <h2 class="h-section">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "made for every day" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "airism cotton, relaxed fits, and wardrobe staples that work as hard as you do — delivered to your door anywhere in aotearoa."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "shop the range" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
