<div class="page-width utility-hero section-pad" style="min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
  <p class="h-hero" style="margin-bottom: 8px;">{{ shop.name | downcase }}</p>
  <h1 class="text-secondary" style="font-size: 16px; font-weight: 400;">{{ 'general.password_page.opening_soon' | t }}</h1>

  {%- form 'storefront_password', style: 'max-width: 380px; width: 100%; margin-top: 24px;' -%}
    {%- if form.errors -%}
      <p class="form-errors">{{ form.errors.messages.form }}</p>
    {%- endif -%}
    <div style="display: flex; gap: 8px;">
      <input class="field" type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_label' | t }}" aria-label="{{ 'general.password_page.login_form_password_label' | t }}">
      <button class="btn btn--solid" type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
