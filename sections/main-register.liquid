<div class="page-width account-wrap">
  <h1 class="h-section">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <p class="form-errors">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="form-row">
      <label class="field-label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
      <input class="field" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">
    </div>
    <div class="form-row">
      <label class="field-label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
      <input class="field" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">
    </div>
    <div class="form-row">
      <label class="field-label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
      <input class="field" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required>
    </div>
    <div class="form-row">
      <label class="field-label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
      <input class="field" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
    </div>
    <button class="btn btn--solid btn--full" type="submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Register",
  "settings": []
}
{% endschema %}
