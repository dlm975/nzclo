<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__note"{% render 'text-attrs', s: section.settings, p: 'note' %}>{{ section.settings.blurb }}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="site-footer__heading"{% render 'text-attrs', s: section.settings, p: 'heading' %}>{{ block.settings.heading | downcase }}</h3>
              <ul class="site-footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}"{% render 'text-attrs', s: section.settings, p: 'link' %}>{{ link.title | downcase }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="site-footer__heading"{% render 'text-attrs', s: section.settings, p: 'heading' %}>{{ block.settings.heading | downcase }}</h3>
              {%- form 'customer' -%}
                {%- if form.posted_successfully? -%}
                  <p class="form-success">thanks for signing up</p>
                {%- else -%}
                  {%- if form.errors -%}
                    <p class="form-errors">{{ form.errors.messages.email }}</p>
                  {%- endif -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div style="display: flex; gap: 8px;">
                    <input class="field" type="email" name="contact[email]" placeholder="email address" required aria-label="email address">
                    <button class="btn btn--solid" type="submit">join</button>
                  </div>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_wordmark -%}
      <p class="site-footer__wordmark" aria-hidden="true"{% render 'text-attrs', s: section.settings, p: 'wordmark' %}>{{ shop.name | downcase }}</p>
    {%- endif -%}

    <div class="site-footer__bottom">
      <span{% render 'text-attrs', s: section.settings, p: 'bottom' %}>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | downcase }}{% if section.settings.bottom_suffix != blank %} — {{ section.settings.bottom_suffix }}{% endif %}</span>
      <span style="display: flex; gap: 16px;">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">instagram</a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">tiktok</a>
        {%- endif -%}
        {%- for policy in shop.policies -%}
          <a href="{{ policy.url }}">{{ policy.title | downcase }}</a>
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

