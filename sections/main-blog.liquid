<div class="page-width section-pad">
  <h1 class="h-section">{{ blog.title | downcase }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <a class="blog-card" href="{{ article.url }}">
          <div class="blog-card__media">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="800" height="600">
            {%- endif -%}
          </div>
          <h3>{{ article.title | downcase }}</h3>
          <p class="text-small text-secondary">{{ article.published_at | date: '%d %b %Y' }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
