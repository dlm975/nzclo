<div class="page-width account-wrap" style="max-width: 720px;">
  <p class="text-center"><a class="link-underline" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a></p>
  <h1 class="h-section text-center">{{ 'customer.addresses.title' | t }}</h1>

  <details style="margin-bottom: 28px;">
    <summary class="btn btn--outline" style="width: 100%; justify-content: center;">{{ 'customer.addresses.add_new' | t }}</summary>
    <div style="margin-top: 20px;">
      {%- form 'customer_address', customer.new_address -%}
        {% render 'address-form-fields', form: form %}
        <button class="btn btn--solid btn--full" type="submit">{{ 'customer.addresses.add' | t }}</button>
      {%- endform -%}
    </div>
  </details>

  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="address-card">
        {%- if address == customer.default_address -%}
          <p class="text-small text-secondary" style="margin: 0 0 8px;">{{ 'customer.addresses.default' | t }}</p>
        {%- endif -%}
        {{ address | format_address }}
        <div style="display: flex; gap: 14px; margin-top: 12px;">
          <details>
            <summary class="link-underline" style="cursor: pointer;">{{ 'customer.addresses.edit' | t }}</summary>
            <div style="margin-top: 16px;">
              {%- form 'customer_address', address -%}
                {% render 'address-form-fields', form: form %}
                <button class="btn btn--solid btn--full" type="submit">{{ 'customer.addresses.update' | t }}</button>
              {%- endform -%}
            </div>
          </details>
          {%- form 'customer_address', address, type: 'delete' -%}
            <button class="link-underline" type="submit" style="background: none; border: none; padding: 0; color: inherit; font-family: inherit;" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}');">{{ 'customer.addresses.delete' | t }}</button>
          {%- endform -%}
        </div>
      </div>
    {%- endfor -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Addresses",
  "settings": []
}
{% endschema %}
