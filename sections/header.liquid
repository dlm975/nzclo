{%- liquid
  assign overlay = false
  if template == 'index' and section.settings.transparent_on_home
    assign overlay = true
  endif
-%}

{% style %}
  {% if overlay %}
    #shopify-section-{{ section.id }} {
      position: absolute;
      left: 0;
      right: 0;
      z-index: 40;
    }
  {% else %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 40;
    }
  {% endif %}
{% endstyle %}

{% if overlay %}
  <style>
    body { position: relative; }
  </style>
{% endif %}

<header class="site-header{% if overlay %} site-header--overlay{% endif %}">
  <div class="page-width site-header__inner">
    <button class="site-header__icon site-header__menu-toggle" data-drawer-open="#menu-drawer" aria-label="open menu">
      {% render 'icon', name: 'menu' %}
    </button>

    <nav class="site-header__nav" aria-label="main menu">
      {%- for link in section.settings.menu.links -%}
        <a class="site-header__link" href="{{ link.url }}">{{ link.title | downcase }}</a>
      {%- endfor -%}
    </nav>

    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {%- if settings.logo -%}
        <img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}">
      {%- else -%}
        {{ shop.name | downcase }}
      {%- endif -%}
    </a>

    <div class="site-header__icons">
      <button class="site-header__icon" data-search-toggle aria-label="search">search</button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="site-header__icon" href="{{ routes.account_url }}" aria-label="account">account</a>
      {%- endif -%}
      <a class="site-header__icon" href="{{ routes.cart_url }}" data-cart-link aria-label="cart ({{ cart.item_count }} items)">
        cart&nbsp;(<span data-cart-count>{{ cart.item_count }}</span>)
      </a>
    </div>
  </div>

  <div class="search-bar">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input class="field" type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn btn--solid" type="submit">{{ 'general.search.search' | t }}</button>
    </form>
  </div>
</header>

<div class="menu-drawer" id="menu-drawer">
  <div class="menu-drawer__overlay" data-drawer-close></div>
  <div class="menu-drawer__panel" role="dialog" aria-modal="true" aria-label="menu">
    <button class="drawer-close" data-drawer-close aria-label="close menu">{% render 'icon', name: 'close' %}</button>
    <nav aria-label="mobile menu">
      {%- for link in section.settings.menu.links -%}
        <a class="menu-drawer__link" href="{{ link.url }}">{{ link.title | downcase }}</a>
      {%- endfor -%}
      {%- if shop.customer_accounts_enabled -%}
        <a class="menu-drawer__link" href="{{ routes.account_url }}">account</a>
      {%- endif -%}
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_home",
      "label": "Transparent over homepage hero",
      "default": true
    }
  ]
}
{% endschema %}
