<div class="newsletter section-pad">
  <div class="page-width">
    <div class="newsletter__inner">
      <h2 class="h-section">{{ section.settings.heading }}</h2>
      <p class="text-secondary" style="margin: 0;">{{ section.settings.text }}</p>
      {%- form 'customer' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success" style="margin-top: 20px;">thanks for signing up</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="form-errors" style="margin-top: 20px;">{{ form.errors.messages.email }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter__form">
            <input class="field" type="email" name="contact[email]" placeholder="email address" required aria-label="email address">
            <button class="btn btn--solid" type="submit">sign up</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "join the list" },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "restocks, new drops, and nz-only offers. no spam."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
