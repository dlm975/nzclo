<div class="newsletter section-pad">
  <div class="page-width">
    <div class="newsletter__inner">
      <h2 class="h-section"{% render 'text-attrs', s: section.settings, p: 'heading' %}>{{ section.settings.heading }}</h2>
      <p class="text-secondary newsletter__text"{% render 'text-attrs', s: section.settings, p: 'body' %}>{{ section.settings.text }}</p>
      {%- form 'customer' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success" style="margin-top: 20px;">thanks for signing up</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="form-errors" style="margin-top: 20px;">{{ form.errors.messages.email }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter__form">
            <input class="field" type="email" name="contact[email]" placeholder="email address" required aria-label="email address">
            <button class="btn btn--solid" type="submit"{% render 'text-attrs', s: section.settings, p: 'button' %}>{{ section.settings.button_label | default: 'sign up' }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

