<div class="page-width section-pad">
  <div class="section-header">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="text-small text-secondary lowercase" style="margin: 0 0 6px; letter-spacing: 0.08em;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h-section" style="margin: 0;">{{ section.settings.heading | default: section.settings.collection.title | downcase }}</h2>
    </div>
    <a class="link-underline" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">shop all</a>
  </div>

  <div class="{% if section.settings.layout == 'grid' %}product-grid{% else %}product-rail{% endif %}">
    {%- assign col = section.settings.collection -%}
    {%- if col != blank and col.products.size > 0 -%}
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-card">
          <span class="product-card__media">
            <span class="product-card__shot">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
            <span class="product-card__scrim"></span>
            <span class="product-card__info">
              <span class="product-card__eyebrow">choose a collection</span>
              <h3 class="product-card__title">example product</h3>
              <span class="product-card__row">
                <span class="product-card__price">$0.00</span>
              </span>
            </span>
          </span>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (optional — collection title used if empty)" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "rail", "label": "Horizontal scroll" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "rail"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
