<div class="cart-drawer" id="cart-drawer">
  <span data-cart-count-source="{{ cart.item_count }}" hidden></span>
  <div class="cart-drawer__overlay" data-drawer-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <div class="cart-drawer__header">
      <h2>{{ 'cart.general.title' | t }} ({{ cart.item_count }})</h2>
      <button class="drawer-close" data-drawer-close aria-label="close">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- liquid
      assign t1 = settings.cart_reward_tier1_qty | default: 2
      assign t2 = settings.cart_reward_tier2_qty | default: 3
      assign count = cart.item_count

      comment
        Milestones are spaced evenly along the track, as in the reference, and the
        fill interpolates between them, so the bar always reads as progress toward
        the next reward rather than toward the final total.
      endcomment
      if count >= t1
        assign span = t2 | minus: t1
        if span > 0
          assign over = count | minus: t1
          assign extra = over | times: 50.0 | divided_by: span
          assign pct = extra | plus: 50
        else
          assign pct = 100
        endif
      elsif t1 > 0
        assign pct = count | times: 50.0 | divided_by: t1
      else
        assign pct = 100
      endif
      if pct > 100
        assign pct = 100
      endif

      if count >= t2
        assign reward_msg = settings.cart_reward_msg_complete
      elsif count >= t1
        assign remaining = t2 | minus: count
        assign reward_msg = settings.cart_reward_msg_tier1 | replace: '[n]', remaining
      elsif count == 0
        assign reward_msg = settings.cart_reward_msg_start | replace: '[n]', t1
      else
        assign remaining = t1 | minus: count
        assign reward_msg = settings.cart_reward_msg_progress | replace: '[n]', remaining
      endif
    -%}

    {%- if settings.cart_reward_enable -%}
      <div class="cart-rewards">
        {%- if reward_msg != blank -%}
          <p class="cart-rewards__message">{{ reward_msg }}</p>
        {%- endif -%}

        <div class="cart-rewards__track">
          <span class="cart-rewards__fill" data-cart-progress data-progress="{{ pct }}"></span>

          <span class="cart-rewards__node{% if count >= t1 %} is-complete{% endif %}" style="left: 50%;">
            {%- if count >= t1 -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7"/><circle cx="8" cy="8" r="2.2"/><circle cx="16" cy="16" r="2.2"/></svg>
            {%- endif -%}
          </span>

          <span class="cart-rewards__node{% if count >= t2 %} is-complete{% endif %}" style="left: 100%;">
            {%- if count >= t2 -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 7.5h10v9h-10zM12.5 11h4l3 3v2.5h-7z"/><circle cx="6" cy="17.5" r="1.6"/><circle cx="16" cy="17.5" r="1.6"/></svg>
            {%- endif -%}
          </span>

          <span class="cart-rewards__label" style="left: 50%;">
            <span class="cart-rewards__label-name">{{ settings.cart_reward_tier1_label }}</span>
            <span class="cart-rewards__label-qty">{{ t1 }} items</span>
          </span>
          <span class="cart-rewards__label" style="left: 100%;">
            <span class="cart-rewards__label-name">{{ settings.cart_reward_tier2_label }}</span>
            <span class="cart-rewards__label-qty">{{ t2 }} items</span>
          </span>
        </div>
      </div>
    {%- endif -%}

    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty">
        <p class="text-secondary">{{ 'cart.general.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <div class="cart-drawer__lines">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <a class="cart-line__media" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="125" loading="lazy">
              {%- endif -%}
            </a>
            <div>
              <p class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title | downcase }}</a></p>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-line__meta">{{ item.variant.title | downcase }}</p>
              {%- endunless -%}
              <div class="qty-input">
                <button type="button" data-qty-change="-1" aria-label="decrease quantity">&minus;</button>
                <input type="number" data-line-qty data-line-key="{{ item.key }}" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity' | t }}">
                <button type="button" data-qty-change="1" aria-label="increase quantity">+</button>
              </div>
            </div>
            <div class="cart-line__price">
              {{ item.final_line_price | money }}
              <br>
              <a class="link-underline text-small" href="#" data-line-remove data-line-key="{{ item.key }}">{{ 'cart.general.remove' | t }}</a>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- comment -%}
        Add-ons appear only while a reward is still out of reach, and disappear as
        soon as the final threshold is met. The drawer re-renders on every cart
        change, so this re-evaluates itself without extra scripting.
      {%- endcomment -%}
      {%- liquid
        assign addon_t2 = settings.cart_reward_tier2_qty | default: 3
        assign show_addons = false
        if settings.cart_addon_enable and cart.item_count < addon_t2
          assign show_addons = true
        endif
      -%}

      {%- if show_addons -%}
        {%- liquid
          assign addon_source = settings.cart_addon_collection
          if addon_source == blank
            assign addon_source = collections.all
          endif
          assign addon_limit = settings.cart_addon_count | default: 3
          assign addon_shown = 0
          assign in_cart_ids = '|'
          for item in cart.items
            assign in_cart_ids = in_cart_ids | append: item.product_id | append: '|'
          endfor
        -%}

        {%- capture addon_rows -%}
          {%- for addon in addon_source.products -%}
            {%- if addon_shown >= addon_limit -%}{%- break -%}{%- endif -%}
            {%- unless addon.available -%}{%- continue -%}{%- endunless -%}
            {%- assign addon_needle = '|' | append: addon.id | append: '|' -%}
            {%- if in_cart_ids contains addon_needle -%}{%- continue -%}{%- endif -%}

            <button
              type="button"
              class="cart-addon-card"
              data-addon-handle="{{ addon.handle }}"
              aria-label="{{ addon.title | escape }}"
            >
              <span class="cart-addon-card__media">
                {%- if addon.featured_media -%}
                  <img
                    src="{{ addon.featured_media | image_url: width: 300 }}"
                    srcset="{{ addon.featured_media | image_url: width: 200 }} 200w, {{ addon.featured_media | image_url: width: 300 }} 300w"
                    sizes="110px"
                    alt=""
                    loading="lazy"
                    width="110"
                    height="138"
                  >
                {%- endif -%}
              </span>
              <span class="cart-addon-card__title">{{ addon.title }}</span>
            </button>

            {%- assign addon_shown = addon_shown | plus: 1 -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if addon_rows != blank -%}
          <div class="cart-addons">
            <div class="cart-addons__head">
              {%- if settings.cart_addon_heading != blank -%}
                <p class="cart-addons__heading">{{ settings.cart_addon_heading }}</p>
              {%- endif -%}
              <span class="cart-addons__nav">
                <button type="button" class="cart-addons__arrow" data-addon-prev aria-label="Previous">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
                </button>
                <button type="button" class="cart-addons__arrow" data-addon-next aria-label="Next">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                </button>
              </span>
            </div>
            <div class="cart-addons__track" data-addon-track>{{ addon_rows }}</div>
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="cart-drawer__footer">
        <div class="cart-summary__total">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="text-small text-secondary" style="margin: 0 0 14px;">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
        {%- if settings.cart_social_enable and settings.cart_social_text != blank -%}
          <div class="cart-social">
            {%- if settings.cart_social_image -%}
              <img
                class="cart-social__badge"
                src="{{ settings.cart_social_image | image_url: width: 400 }}"
                alt="{{ settings.cart_social_text | escape }}"
                loading="lazy"
                width="{{ settings.cart_social_image_height | times: settings.cart_social_image.aspect_ratio | round }}"
                height="{{ settings.cart_social_image_height }}"
                style="height: {{ settings.cart_social_image_height }}px;"
              >
            {%- else -%}
              <span class="cart-social__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <svg class="cart-social__star" viewBox="0 0 24 24"><path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6-5.9-3.2-5.9 3.2 1.2-6.6L2.5 9.6l6.6-.9z"/></svg>
                {%- endfor -%}
              </span>
            {%- endif -%}
            <span class="cart-social__text">{{ settings.cart_social_text }}</span>
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" method="post">
          <button class="btn btn--solid btn--full" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button>
        </form>

        {%- comment -%}
          Driven by the store's own payment configuration, so only methods that
          are actually enabled appear, using Shopify's official brand SVGs.
        {%- endcomment -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="cart-payments" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="cart-payments__item">
                {{ type | payment_type_svg_tag: class: 'cart-payments__icon' }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="mini-pdp" id="mini-pdp" data-money-format="{{ shop.money_format | escape }}" hidden>
      <div class="mini-pdp__scrim" data-minipdp-close></div>
      <div class="mini-pdp__sheet" role="dialog" aria-modal="true" aria-label="{{ 'products.product.choose_options' | t }}">
        <button type="button" class="mini-pdp__close" data-minipdp-close aria-label="{{ 'cart.general.remove' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
        <div class="mini-pdp__body" data-minipdp-body></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
