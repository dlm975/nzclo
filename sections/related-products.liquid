<div class="page-width section-pad" style="padding-top: 0;">
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="section-header">
      <h2 class="h-section" style="margin: 0;">{{ section.settings.heading }}</h2>
    </div>
    <div class="product-rail">
      {%- for product in recommendations.products -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div
      data-related-products
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=8"
    ></div>
    <script>
      (function () {
        var el = document.querySelector('[data-related-products][data-url]');
        if (!el) return;
        fetch(el.getAttribute('data-url'))
          .then(function (r) { return r.text(); })
          .then(function (text) {
            var doc = new DOMParser().parseFromString(text, 'text/html');
            var inner = doc.querySelector('.shopify-section');
            if (inner && inner.querySelector('.product-card')) {
              el.closest('.shopify-section').innerHTML = inner.innerHTML;
            }
          })
          .catch(function () {});
      })();
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "you may also like" }
  ]
}
{% endschema %}
