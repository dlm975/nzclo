<div class="page-width section-pad" style="padding-top: 0;">
  {%- if section.settings.heading != blank -%}
    <div class="section-header">
      <h2 class="h-section" style="margin: 0;">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="collection-tiles" style="--tiles: {{ section.blocks.size | at_least: 1 }};">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <a
        class="collection-tile"
        href="{{ col.url | default: routes.all_products_collection_url }}"
        {{ block.shopify_attributes }}
      >
        {%- assign tile_image = block.settings.image | default: col.featured_image -%}
        {%- if tile_image -%}
          <img
            src="{{ tile_image | image_url: width: 900 }}"
            srcset="{{ tile_image | image_url: width: 600 }} 600w, {{ tile_image | image_url: width: 900 }} 900w, {{ tile_image | image_url: width: 1400 }} 1400w"
            sizes="(max-width: 749px) 100vw, 33vw"
            alt="{{ tile_image.alt | default: block.settings.label | escape }}"
            loading="lazy"
            width="900"
            height="1200"
          >
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        <span class="collection-tile__word{% if block.settings.light_text %} collection-tile__word--light{% endif %}">{{ block.settings.label | default: col.title | downcase }}</span>
        {%- if block.settings.badge != blank -%}
          <span class="collection-tile__badge">{{ block.settings.badge }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional — collection image used if empty)" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "badge", "label": "Badge (e.g. new)" },
        { "type": "checkbox", "id": "light_text", "label": "Light label text", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "mens" } },
        { "type": "tile", "settings": { "label": "womens" } },
        { "type": "tile", "settings": { "label": "shop all" } }
      ]
    }
  ]
}
{% endschema %}
