<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap">
    {{ content_for_header }}
    {% style %}
      :root {
        --color-text: {{ settings.color_text.rgb | replace: ' ', ', ' }};
        --color-text-secondary: {{ settings.color_text_secondary.rgb | replace: ' ', ', ' }};
        --color-background: {{ settings.color_background.rgb | replace: ' ', ', ' }};
        --color-tile: {{ settings.color_tile.rgb | replace: ' ', ', ' }};
        --color-button: {{ settings.color_button.rgb | replace: ' ', ', ' }};
        --color-button-text: {{ settings.color_button_text.rgb | replace: ' ', ', ' }};
      }
    {% endstyle %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
